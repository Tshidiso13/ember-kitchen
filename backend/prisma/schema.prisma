generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentMode {
  DELIVERY
  COLLECTION
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  phone            String?
  passwordHash     String
  role             Role       @default(CUSTOMER)
  address          String?
  refreshTokenHash String?
  isActive         Boolean    @default(true)
  favourites       Favourite[]
  orders           Order[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String
  tag         String?
  allergens   String?
  extraName   String?
  extraPrice  Decimal     @default(0) @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  favourites  Favourite[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, isAvailable])
}

model Favourite {
  userId     String
  menuItemId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, menuItemId])
}

model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        OrderStatus     @default(PENDING)
  fulfillment   FulfillmentMode
  subtotal      Decimal         @db.Decimal(10, 2)
  deliveryFee   Decimal         @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod   @default(CASH)
  paymentStatus PaymentStatus   @default(UNPAID)
  deliveryName  String
  deliveryPhone String
  address       String?
  notes         String?
  items         OrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String?
  name        String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  extraName   String?
  extraPrice  Decimal  @default(0) @db.Decimal(10, 2)
  note        String?
  createdAt   DateTime @default(now())
}

model RestaurantSettings {
  id              String   @id @default("main")
  restaurantName  String   @default("Ember Kitchen")
  phone           String?
  address         String?
  deliveryFee     Decimal  @default(25) @db.Decimal(10, 2)
  minimumOrder    Decimal  @default(0) @db.Decimal(10, 2)
  acceptingOrders Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
